{
  "expo": {
    "name": "JIVO JM",
    "slug": "jivo-jm-universal",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./public/icons/icon-512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jivo.jm",
      "icon": "./public/icons/maskable-512.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./public/icons/maskable-512.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jivo.jm",
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./public/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      "@preeternal/react-native-cookie-manager",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow JIVO JM to record a voice message when you tap Start recording.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow JIVO JM to take a photo when you choose Camera.",
          "photosPermission": false,
          "microphonePermission": "Allow JIVO JM to record a voice message when you choose to record."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow JIVO JM to read the contact you select for sharing."
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow JIVO JM to verify your identity when unlocking the app."
        }
      ],
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ],
            "multipleShareMimeTypes": [
              "text/*",
              "image/*",
              "video/*",
              "audio/*",
              "application/*"
            ]
          },
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.jivo.jm",
            "extensionBundleIdentifier": "com.jivo.jm.ShareExtension",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow JIVO JM to use your location when you choose to share a location or an event place."
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#16a34a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/jm-mark.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8f6",
          "dark": {
            "image": "./assets/brand/jm-mark.png",
            "backgroundColor": "#0c1210"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow JIVO JM to take photos you choose to share.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow JIVO JM to show recent photos for sharing.",
          "savePhotosPermission": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "scheme": "jivo-jm",
    "extra": {
      "eas": {
        "projectId": "317d0883-008d-4947-8877-03c463e00b65"
      }
    },
    "owner": "rohitrathod12"
  }
}
